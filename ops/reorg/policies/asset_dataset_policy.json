{
  "managed_roots": [
    "courses/*/assets",
    "courses/*/datasets"
  ],
  "name_regex": "^[a-z0-9._-]+$",
  "enforce_extension": true,
  "allowed_extensions": [
    ".md",
    ".txt",
    ".csv",
    ".tsv",
    ".json",
    ".yaml",
    ".yml",
    ".xml",
    ".rtf",
    ".pdf",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".bmp",
    ".tif",
    ".tiff",
    ".webp",
    ".svg",
    ".wav",
    ".mp3",
    ".mp4",
    ".mov",
    ".avi",
    ".mkv",
    ".npy",
    ".npz",
    ".pt",
    ".pth",
    ".onnx",
    ".h5",
    ".zip",
    ".tar",
    ".gz",
    ".tar.gz",
    ".ply",
    ".pcd",
    ".obj",
    ".mtl",
    ".stl",
    ".raw",
    ".fasta",
    ".fasta.txt",
    ".dat",
    ".aln-clustal_num"
  ],
  "allowed_filenames": [
    "README",
    "README.md",
    "LICENSE",
    ".gitkeep"
  ],
  "ignore_rules_file": "ops/reorg/policies/asset_dataset_ignore.txt",
  "whitelist_file": "ops/reorg/policies/asset_dataset_whitelist.txt"
}
